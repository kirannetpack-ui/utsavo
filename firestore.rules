rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Security Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'kiran67311@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'role', 'createdAt', 'organization', 'assignedVenueId']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 100 &&
        data.role in ['CUSTOMER', 'VENUE_OWNER', 'EVENT_ORGANIZER', 'SUPER_ADMIN', 'FINANCE_ADMIN'];
    }

    function isValidWorkspacePreferences(data) {
      return data.keys().hasAll(['uid', 'savedVenueIds', 'savedVendorIds', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'savedVenueIds', 'savedVendorIds', 'preferredLanguage', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
        data.savedVenueIds is list && data.savedVenueIds.size() <= 100 &&
        data.savedVendorIds is list && data.savedVendorIds.size() <= 100 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('preferredLanguage' in data) || (data.preferredLanguage in ['en', 'ne']));
    }

    function isValidAiChatSession(data) {
      return data.keys().hasAll(['uid', 'title', 'rolePreset', 'modelTier', 'messages', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'title', 'rolePreset', 'modelTier', 'messages', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.rolePreset is string && data.rolePreset.size() <= 60 &&
        data.modelTier in ['FAST', 'GENERAL', 'DEEP'] &&
        data.messages is list && data.messages.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['bookingRef', 'customerId', 'venueId', 'status']) &&
        data.bookingRef is string && data.bookingRef.size() <= 32 &&
        data.customerId is string && data.customerId.size() <= 128 &&
        data.venueId is string && data.venueId.size() <= 128 &&
        data.status in ['ON_HOLD', 'DEPOSIT_PAID', 'CONFIRMED', 'COMPLETED', 'CANCELLED', 'DISPUTED'];
    }

    function isValidNegotiation(data) {
      return data.keys().hasAll(['venueId', 'customerId', 'status']) &&
        data.venueId is string && data.venueId.size() <= 128 &&
        data.customerId is string && data.customerId.size() <= 128 &&
        data.status is string && data.status.size() <= 50;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['venueId', 'overallRating', 'comment']) &&
        data.venueId is string && data.venueId.size() <= 128 &&
        data.overallRating is number && data.overallRating >= 1 && data.overallRating <= 5 &&
        data.comment is string && data.comment.size() <= 1000;
    }

    function isValidDestinationInquiry(data) {
      return data.keys().hasAll(['inquiryRef', 'clientName', 'clientEmail', 'targetDestination']) &&
        data.inquiryRef is string && data.inquiryRef.size() <= 32 &&
        data.clientName is string && data.clientName.size() <= 100 &&
        data.clientEmail is string && data.clientEmail.size() <= 100 &&
        data.targetDestination is string && data.targetDestination.size() <= 150;
    }

    function isValidManagedEventRequest(data) {
      return data.keys().hasAll(['requestRef', 'clientName', 'clientEmail', 'eventTitle', 'status']) &&
        data.requestRef is string && data.requestRef.size() <= 40 &&
        data.clientName is string && data.clientName.size() <= 120 &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        data.eventTitle is string && data.eventTitle.size() <= 180 &&
        data.status in ['DRAFT_DISCOVERY', 'BRIEF_SUBMITTED', 'BLUEPRINT_REVIEW', 'VENDOR_SOURCING_ACTIVE', 'COORDINATION_LOCKED', 'EXECUTION_READY'];
    }

    // 1. Users Collection & Private Workspace Subcollections
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && isAdmin();

      match /workspace/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(docId) && isOwner(userId) && isValidWorkspacePreferences(incoming());
        allow update: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin()) && isValidWorkspacePreferences(incoming()) && incoming().uid == existing().uid;
        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      }

      match /chatSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(sessionId) && isOwner(userId) && isValidAiChatSession(incoming());
        allow update: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin()) && isValidAiChatSession(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
      }
    }

    // 2. Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBooking(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isSignedIn() && isValidBooking(incoming()) && (
        existing().customerId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 3. Negotiations Collection
    match /negotiations/{negotiationId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidNegotiation(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isSignedIn() && isValidNegotiation(incoming());
      allow delete: if isAdmin();
    }

    // 4. Reviews Collection
    match /reviews/{reviewId} {
      allow get, list: if true; // Public verified reviews
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update, delete: if isAdmin();
    }

    // 5. Destination Inquiries Collection
    match /destinationInquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && (isAdmin() || (isVerifiedUser() && resource.data.clientEmail == request.auth.token.email));
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId) && isSignedIn() && isValidDestinationInquiry(incoming());
      allow update, delete: if isValidId(inquiryId) && isAdmin();
    }

    // 6. Digital Invitations & RSVPs
    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId); // Public guest invitation view by ID
      allow list: if isAdmin();
      allow create: if isValidId(invitationId) && isSignedIn();
      allow update: if isValidId(invitationId) && (
        isAdmin() ||
        isSignedIn() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['rsvpCount', 'rsvpResponses', 'updatedAt'])
      );
      allow delete: if isValidId(invitationId) && isAdmin();
    }

    // 7. Cultural Artists & Vendors Directory
    match /culturalVendors/{vendorId} {
      allow get, list: if true; // Public artist directory catalog
      allow create: if isValidId(vendorId) && isSignedIn();
      allow update, delete: if isValidId(vendorId) && isAdmin();
    }

    // 8. Test connection doc (read-only connectivity check, no client writes)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // 9. Social Celebration Posts & Authentic Photo Wall
    match /social_posts/{postId} {
      allow get, list: if true; // Public celebration wall browsing
      allow create: if isValidId(postId) && isSignedIn();
      allow update: if isValidId(postId) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
      );
      allow delete: if isValidId(postId) && isAdmin();
    }

    // 10. UTSAVO Full-Service Managed Event Requests & Direct Team Coordination
    match /managedEventRequests/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isVerifiedUser() && resource.data.clientEmail == request.auth.token.email));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.clientEmail == request.auth.token.email);
      allow create: if isValidId(requestId) && isSignedIn() && isValidManagedEventRequest(incoming());
      allow update: if isValidId(requestId) && isValidManagedEventRequest(incoming()) && (
        isAdmin() || (isVerifiedUser() && existing().clientEmail == request.auth.token.email)
      );
      allow delete: if isValidId(requestId) && isAdmin();
    }
  }
}


